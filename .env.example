# Optional overrides. The suite runs with these defaults and needs no secrets.
# Playwright starts the local Harbor Desk server for you.

DEMO_BASE_URL=http://127.0.0.1:4173

# Public practice credentials published by Swag Labs (saucedemo.com).
# These are not secrets. Do not replace them with real account passwords.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
